#!/bin/sh
# AetherOS /init — 内核引导的第一个用户态程序（rootfs overlay）
# initramfs 启动后以 PID 1 执行本脚本，交接给 aether-init。
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null

# 回环接口必须显式拉起：内核默认 lo 是 down 的。不拉起则 aetherd（127.0.0.1:7311）
# 虽能 bind 却等不到任何连接，compositor 的 AI 查询 connect 无限期阻塞。
ip link set lo up 2>/dev/null || ifconfig lo up 2>/dev/null

# AI 中枢只听回环（aetherd 默认 127.0.0.1）。宿主调试需要 hostfwd 直连时，
# 由调试脚本显式注入 AETHER_BIND=0.0.0.0，出厂镜像绝不对外暴露 IPC。

echo "[init] AetherOS 0.1 — 交接给 aether-init"
exec /usr/bin/aether-init --pid1
