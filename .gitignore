# 构建期生成（build-iso.sh 拷入的自研二进制与中文字体），不是源文件
/platform/overlay/usr/

# 构建机 SSH 主机密钥记录（TOFU，每台机器不同）
scripts/.vm_known_hosts
# 生产部署的主机密钥记录（同上；2026-10-02 审计 H-5 引入，提交信息里声称已加但当时没落地）
scripts/.vps_known_hosts

# 认证基线：口令哈希只应出现在构建产物里，绝不入库（2026-10-02 审计 M-4 加固）
/platform/overlay/etc/shadow
platform/overlay/etc/shadow

# AI 助手本地权限配置（各人环境不同，靠全局 ignore 不可靠）
.claude/settings.local.json

# 工作区数据（AI 助手记忆/会话缓存），不纳入版本控制
.workbuddy/
.workbuddy-ai/

# 站点生成物（scripts/gen-site.py 生成，不入库）
site/sitemap.xml
site/robots.txt
site/404.html
site/assets/img/
